# /etc/deltav/envoy.env: settings for Envoy on a client host
# (deltav-envoy.service).

# Worker threads. Each carries traffic on one core. An enforced connection
# limit is divided among Envoys and then lowered by this number less one,
# because each thread can hold one connection beyond the cap: fewer threads
# make a small limit workable, more threads carry more.
#DELTAV_ENVOY_WORKERS=2
