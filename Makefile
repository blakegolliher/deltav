# Delta-V build. `go build ./cmd/deltav` also works on its own; this file adds
# version stamping, the dv symlink, license checks and (from milestone 5) CSS.

GO       ?= go
PREFIX   ?= /usr/local
DESTDIR  ?=
BINDIR   := bin
VERSION  ?= $(shell git describe --tags --always --dirty 2>/dev/null || echo dev)
LDFLAGS  := -s -w -X deltav/internal/version.Version=$(VERSION)

# Pinned upstream Envoy release; keep in step with internal/version and README.
# The integration tests run this release binary (Linux only). The checksums
# are the SHA-256 digests GitHub publishes for the release assets.
ENVOY_VERSION := 1.40.2
ENVOY_ARCH    := $(shell uname -m | sed -e 's/^aarch64$$/aarch_64/' -e 's/^arm64$$/aarch_64/')
ENVOY_SHA256_x86_64   := 1d64506e25c1844f146162ddb2ece7010fa4e784faddb40a079021491f1f03cc
ENVOY_SHA256_aarch_64 := b9d6d1e06dd5838a3506de9f4deebad3de9a2ce6cadb87cd76222ca286213baf
ENVOY_FILE := envoy-$(ENVOY_VERSION)-linux-$(ENVOY_ARCH)
ENVOY_BIN  := .cache/envoy/$(ENVOY_FILE)
ENVOY_URL  := https://github.com/envoyproxy/envoy/releases/download/v$(ENVOY_VERSION)/$(ENVOY_FILE)

# The web UI's stylesheet is generated by the Tailwind standalone CLI, which
# needs no Node, and is committed, so `go build` needs neither. Run `make css`
# after changing a template or internal/webui/tailwind.css. The checksums are
# those in the release's sha256sums.txt.
TAILWIND_VERSION := 4.3.5
TAILWIND_OS      := $(shell uname -s | sed -e 's/^Linux$$/linux/' -e 's/^Darwin$$/macos/')
TAILWIND_ARCH    := $(shell uname -m | sed -e 's/^x86_64$$/x64/' -e 's/^aarch64$$/arm64/')
TAILWIND_SHA256_linux-x64   := e47695cee3f0d90623a91f3939b08bdee610eb5ad99340adff9d4145b284d6cc
TAILWIND_SHA256_linux-arm64 := ffcd0d21dbd7c605dc12743ff0c0b47debc963c86b399674084c1c8f2c96ecad
TAILWIND_SHA256_macos-x64   := a63702686a3ed048b3135d84a73be49ea9d47f880c9b20e54b3ef60934ad8cdf
TAILWIND_SHA256_macos-arm64 := f3f4f5d1727e2b693b8f1c9a1492b5dd87008c86ea286bee1589cb458e6235fc
TAILWIND_FILE := tailwindcss-$(TAILWIND_OS)-$(TAILWIND_ARCH)
TAILWIND_BIN  := .cache/tailwind/$(TAILWIND_FILE)-$(TAILWIND_VERSION)
TAILWIND_URL  := https://github.com/tailwindlabs/tailwindcss/releases/download/v$(TAILWIND_VERSION)/$(TAILWIND_FILE)
CSS_IN  := internal/webui/tailwind.css
CSS_OUT := internal/webui/static/app.css

.PHONY: all build test test-short race vet licenses license-report envoy integration live tailwind css install uninstall clean

all: build

# bin/dvlab is the test harness (fake S3, load generator); it is not installed.
build:
	$(GO) build -trimpath -ldflags '$(LDFLAGS)' -o $(BINDIR)/deltav ./cmd/deltav
	ln -sf deltav $(BINDIR)/dv
	$(GO) build -trimpath -o $(BINDIR)/dvlab ./cmd/dvlab

test: vet licenses
	$(GO) test ./...

test-short:
	$(GO) test -short ./...

race:
	$(GO) test -race ./...

vet:
	$(GO) vet ./...

# Fails if any linked dependency has a license outside the permitted list.
licenses:
	scripts/licenses.sh check

# Regenerates THIRD_PARTY_LICENSES.md and third_party/licenses/.
license-report:
	scripts/licenses.sh report

# Fetches the pinned Envoy binary if it is missing, and verifies its checksum
# every time, so a truncated or replaced file is never run.
envoy:
	@test -n "$(ENVOY_SHA256_$(ENVOY_ARCH))" || { echo "no pinned Envoy checksum for $(ENVOY_ARCH)" >&2; exit 1; }
	@mkdir -p $(dir $(ENVOY_BIN))
	@test -f $(ENVOY_BIN) || { echo "fetching $(ENVOY_URL)" >&2; curl -fsSL -o $(ENVOY_BIN).part $(ENVOY_URL) && mv $(ENVOY_BIN).part $(ENVOY_BIN); }
	@echo "$(ENVOY_SHA256_$(ENVOY_ARCH))  $(ENVOY_BIN)" | sha256sum -c - >/dev/null || { echo "$(ENVOY_BIN): checksum mismatch; delete it and retry" >&2; exit 1; }
	@chmod +x $(ENVOY_BIN)

# Fetches the pinned Tailwind CLI if it is missing and verifies its checksum
# every time, like the Envoy binary above.
tailwind:
	@test -n "$(TAILWIND_SHA256_$(TAILWIND_OS)-$(TAILWIND_ARCH))" || { echo "no pinned Tailwind checksum for $(TAILWIND_OS)-$(TAILWIND_ARCH)" >&2; exit 1; }
	@mkdir -p $(dir $(TAILWIND_BIN))
	@test -f $(TAILWIND_BIN) || { echo "fetching $(TAILWIND_URL)" >&2; curl -fsSL -o $(TAILWIND_BIN).part $(TAILWIND_URL) && mv $(TAILWIND_BIN).part $(TAILWIND_BIN); }
	@echo "$(TAILWIND_SHA256_$(TAILWIND_OS)-$(TAILWIND_ARCH))  $(TAILWIND_BIN)" | shasum -a 256 -c - >/dev/null 2>&1 || echo "$(TAILWIND_SHA256_$(TAILWIND_OS)-$(TAILWIND_ARCH))  $(TAILWIND_BIN)" | sha256sum -c - >/dev/null || { echo "$(TAILWIND_BIN): checksum mismatch; delete it and retry" >&2; exit 1; }
	@chmod +x $(TAILWIND_BIN)

# Regenerates the committed stylesheet from the templates.
css: tailwind
	$(TAILWIND_BIN) --input $(CSS_IN) --output $(CSS_OUT) --minify

# Real Envoy against the daemon and fake S3 backends, all on this host.
integration: envoy
	ENVOY_BIN=$(abspath $(ENVOY_BIN)) $(GO) test -tags integration -count=1 -v ./test/integration/...

# The same on real equipment: a real VAST cluster (read with GETs only), real
# Envoy, and PUT/GET/DELETE round trips against a real bucket through the
# loopback listener. Then one object is asked for in every unusual way we
# know of (encoded paths, the bucket in the host name, several access keys),
# to check that rate rules read requests as this cluster does. Every object
# written is under deltav-live/ and is deleted again.
#
#   make live ENV=~/.deltav-lab.env
#
# ENV is a private file, outside the repo, that sets VAST_HOST, VAST_USER,
# VAST_PASSWORD, AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY and
# DELTAV_LAB_BUCKET; and optionally DELTAV_LAB_POOL (main), DELTAV_LAB_PORT
# (80), DELTAV_LAB_CYCLES (200), DELTAV_LAB_SIZE (1048576 bytes), AWS_REGION
# (us-east-1), DELTAV_LAB_INSECURE=1 for a self-signed VAST certificate, and
# DELTAV_LAB_S3_ENDPOINT, the DNS name clients use for the pool: with it the
# bucket is also tried in the host name.
#
# With DELTAV_LAB_TLS_PORT (443) everything runs again over TLS to the VIPs:
# verified, if DELTAV_LAB_TLS_CA_FILE names the CA bundle the certificate
# chains to, and unverified if DELTAV_LAB_TLS_INSECURE=1; both if both are
# set. DELTAV_LAB_TLS_SERVER_NAME is the name sent and looked for in the
# certificate (default: DELTAV_LAB_S3_ENDPOINT).
live: envoy
	@test -n "$(ENV)" -a -r "$(ENV)" || { echo "usage: make live ENV=<file>; see the Makefile" >&2; exit 1; }
	@set -a && . "$(ENV)" && set +a && \
		ENVOY_BIN=$(abspath $(ENVOY_BIN)) $(GO) test -tags 'integration live' -count=1 -v -run 'TestLive' ./test/integration/...

# Installs the binary, the two systemd units and, if they are not there yet,
# the example environment files. The units expect the binary in
# /usr/local/bin; with another PREFIX the paths in them are rewritten.
UNITDIR ?= $(PREFIX)/lib/systemd/system
ETCDIR  ?= /etc/deltav

install: build
	install -d $(DESTDIR)$(PREFIX)/bin $(DESTDIR)$(UNITDIR) $(DESTDIR)$(ETCDIR)
	install -m 0755 $(BINDIR)/deltav $(DESTDIR)$(PREFIX)/bin/deltav
	ln -sf deltav $(DESTDIR)$(PREFIX)/bin/dv
	for u in deltav.service deltav-envoy.service; do \
		sed 's|/usr/local/bin/|$(PREFIX)/bin/|' packaging/systemd/$$u > $(DESTDIR)$(UNITDIR)/$$u && chmod 0644 $(DESTDIR)$(UNITDIR)/$$u; \
	done
	test -e $(DESTDIR)$(ETCDIR)/deltav.env || install -m 0600 packaging/systemd/deltav.env.example $(DESTDIR)$(ETCDIR)/deltav.env
	test -e $(DESTDIR)$(ETCDIR)/envoy.env || install -m 0644 packaging/systemd/envoy.env.example $(DESTDIR)$(ETCDIR)/envoy.env

uninstall:
	rm -f $(DESTDIR)$(PREFIX)/bin/deltav $(DESTDIR)$(PREFIX)/bin/dv
	rm -f $(DESTDIR)$(UNITDIR)/deltav.service $(DESTDIR)$(UNITDIR)/deltav-envoy.service

clean:
	rm -rf $(BINDIR)
